# Local development only. Never put real credentials in this tracked file.
# Render: set DATABASE_URL to the database's Internal Database URL instead of DB_*.
DATABASE_URL=
PUBLIC_SITE_URL=
RESEND_API_KEY=
ACCOUNT_EMAIL_FROM=
# Require encrypted database connections on Render (not the local Mac database).
# PGSSLMODE=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=on_the_dot
DB_USER=on_the_dot
DB_PASSWORD=

# Production: generate a new stable secret and enable secure HTTPS cookies.
TRIVIA_SESSION_SECRET=
TRIVIA_HTTPS_ONLY=0

# Leave both empty on the public game server to disable editor access.
TRIVIA_EDITOR_USERNAME=
TRIVIA_EDITOR_PASSWORD=

# Optional, only for football data imports, not for playing published questions.
API_FOOTBALL_KEY=
